generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  password       String
  role           userRoles @default(USER)
  age            Int
  timeoutAccount DateTime?
  loginAttempts  Int?
  accountBlocked Boolean?

  refreshToken RefreshToken[] @relation("user-refreshToken")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("Users")
}

model RefreshToken {
  id       String    @id @default(uuid())
  userRole userRoles
  user     User      @relation("user-refreshToken", fields: [userId], references: [id])
  userId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("RefreshToken")
}

enum userRoles {
  SUPERADMIN
  ADMIN
  PROFESSIONAL
  USER
}
